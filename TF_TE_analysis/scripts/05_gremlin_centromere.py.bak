# Two mutation rate estimates (substitutions / site / year)
MU_RATES = {
    "3×10⁻⁹ yr⁻¹ (slow)": 3e-9,
    "1×10⁻⁸ yr⁻¹ (fast)": 1e-8,
}

MU_SPECIES = [
