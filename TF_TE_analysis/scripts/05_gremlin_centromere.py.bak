                                "gremlin_families_tblastn_denovo.tsv")
GREMLIN_FAMILIES_GENOME  = Path("/legserv/Temp/Carlos/EDF-TE/data/gremlin/genome_tblastn_results/"
                                "gremlin_families_genome.tsv")
