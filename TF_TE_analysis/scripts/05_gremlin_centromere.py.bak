                                "gremlin_families_per_species.tsv")

MERGE_DIST      = 50_000   # 50 kb
MIN_ELEMENTS    = 3        # minimum Grem-LINE1 copies to call a cluster
MIN_SPAN        = 500      # minimum cluster span (bp)
H3K9_SCORE_MIN  = 5_000   # score threshold for "strong" H3K9me3 peak
H3K9_START_MAX  = 2_000   # pericentromeric = near scaffold start
DENSITY_WINDOW  = 50_000   # 50 kb bin width for LTR density analysis (BL species)
MIN_BIN_COUNT   = 5        # min LTR elements per 50 kb bin to call a cluster

# Szánthó et al. 2025 node ages (midpoint Ma; 95% HPD low–high)
CLADE_AGES = {
