#!/usr/bin/env python3
"""
05_gremlin_centromere.py
─────────────────────────────────────────────────────────────────────────────
LINE/I (gremlin) cluster analysis as putative centromere markers in
Mucoromycota, with H3K9me3 validation in Rhizopus microsporus.

Analyses
  1.  LINE/I cluster detection (63 MU + 5 BL species; bedtools merge -d 50 kb)
  2.  H3K9me3 validation in Rhizopus (pre-called MACS2 broad peaks)
  3.  Strand-orientation bias per cluster (binomial test)
  4.  Copy-number + Kimura80-divergence dynamics across 63 MU species
  5.  LTR cluster detection in 5 Blastocladiomycota species
  6.  TF-gremlin enrichment (re-uses 03_fimo_enrichment output)
  7.  LINE/I age distribution vs clade divergence times (Haase Fig.2h style)
      Calibrations from Szánthó et al. 2025, Nat. Ecol. Evol. 9:1989
        LCA Mucoromycota+Dikarya : ~1,107 Ma
        Crown Mucoromycota       :  946 Ma  (95% HPD 678–1,213 Ma)
        Glomeromycotina          :  494 Ma  (95% HPD 408–580 Ma)
        Endogonales              :  208 Ma  (95% HPD  76–340 Ma)

Output
  <OUTDIR>/gremlin_clusters/          — per-species BED + summary TSV
  <OUTDIR>/h3k9me3_validation/        — Rhizopus intersect + stats
  <OUTDIR>/bl_ltr_clusters/           — BL species LTR clusters
  <OUTDIR>/gremlin_centromere_analysis.pdf  — 5-panel figure

Usage
  python 05_gremlin_centromere.py [--skip-clusters] [--skip-age]
"""

import argparse
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
from scipy.stats import binomtest, mannwhitneyu, fisher_exact

# ── CONFIG ────────────────────────────────────────────────────────────────────
