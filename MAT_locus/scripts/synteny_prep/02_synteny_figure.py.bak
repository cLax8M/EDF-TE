# ─── TE color coding ──────────────────────────────────────────────────────────
def te_main_class(name):
    """Parse TE class from BLAST query name: 'rnd-1_family-12#RC/Helitron' -> 'RC'"""
    if "#" in name:
        cls = name.split("#")[-1].strip().split("/")[0]
    else:
        cls = "Unknown"
    return cls

TE_COLORS = {
    "LTR":      "#8E44AD",
    "LINE":     "#2471A3",
    "DNA":      "#D4AC0D",
    "RC":       "#17A589",
    "PLE":      "#0E6655",
    "SINE":     "#E91E63",
    "Unknown":  "#95A5A6",
    "Simple":   "#D5D8DC",
    "Low":      "#D5D8DC",
    "Other":    "#BDC3C7",
}

def te_color(cls):
    return TE_COLORS.get(cls, "#BDC3C7")

# ─── Load TE data ─────────────────────────────────────────────────────────────
def load_TE(genome, thr_bp=50):
    """Load BLASTN TE hits, convert to window coords, merge overlapping."""
    scaf, win_s, win_e = WINDOWS[genome]
    tsv = SYNDIR / "rmask" / f"{genome}_TE.tsv"
    if not tsv.exists():
        return pd.DataFrame(columns=["start","end","cls"])
    cols = ["sseqid","sstart","send","pident","length","qseqid","qlen","evalue","bitscore"]
    df = pd.read_csv(tsv, sep="\t", header=None, names=cols)
    if len(df) == 0:
        return pd.DataFrame(columns=["start","end","cls"])
    df = df[df["length"] >= thr_bp].copy()
    df["start_g"] = df[["sstart","send"]].min(axis=1)
    df["end_g"]   = df[["sstart","send"]].max(axis=1)
    df["cls"]     = df["qseqid"].apply(te_main_class)
    # Convert to window coords
    df["start"] = df["start_g"] + win_s - 1  # adjust for genome position
    df["end"]   = df["end_g"]   + win_s - 1
    # Actually: the BLAST DB is the extracted window, so positions are 1-based within window
    df["start"] = df["start_g"] - 1 + win_s  # window-relative → genome
    df["end"]   = df["end_g"]       + win_s
    return df[["start","end","cls"]].copy()

# ─── Load PAF synteny alignments ──────────────────────────────────────────────
def load_PAF(query, target):
    """Load minimap2 PAF, return genome-coord alignment blocks."""
    paf = SYNDIR / f"{query}_vs_{target}.paf"
    if not paf.exists():
        return []
    cols = ["qname","qlen","qstart","qend","strand","tname","tlen","tstart","tend",
            "nmatch","alen","mapq"]
    df = pd.read_csv(paf, sep="\t", header=None, usecols=range(12), names=cols)
    if len(df) == 0:
        return []
    # Convert back to genome coordinates
    q_scaf, q_s, q_e = WINDOWS[query]
    t_scaf, t_s, t_e = WINDOWS[target]
    blocks = []
    for _, r in df.iterrows():
        if r["alen"] < 1000:  # skip tiny alignments
            continue
        # PAF coords are 0-based, within extracted window
        q_gstart = r["qstart"] + q_s
        q_gend   = r["qend"]   + q_s
        t_gstart = r["tstart"] + t_s
        t_gend   = r["tend"]   + t_s
        blocks.append({
            "q_start": q_gstart, "q_end": q_gend,
            "t_start": t_gstart, "t_end": t_gend,
            "strand": r["strand"], "alen": r["alen"]
        })
    return blocks

# ─── Figure drawing ───────────────────────────────────────────────────────────
def genome_to_ax(gpos, win_s, win_e):
    """Convert genome position to [0,1] axis coordinates."""
    wlen = win_e - win_s
    return (gpos - win_s) / wlen

def draw_genome_track(ax, genome, y_center=0.5, track_h=0.04, label_side="left"):
    """Draw one genome track with backbone, genes, TEs, idiomorphic region."""
    scaf, win_s, win_e = WINDOWS[genome]
    wlen = win_e - win_s

    def g2x(pos):  # genome pos → [0,1]
        return (pos - win_s) / wlen

    # Backbone
    ax.axhline(y_center, color="#333333", lw=1.0, zorder=1, xmin=0, xmax=1)

    # Idiomorphic region highlight
    idio = IDIO.get(genome)
    if idio:
        ix0 = max(0, g2x(idio[0]))
        ix1 = min(1, g2x(idio[1]))
        ax.axvspan(ix0, ix1, ymin=0.3, ymax=0.7, color="#F9E79F", alpha=0.6, zorder=0)
        # Dashed border
        ax.plot([ix0, ix0], [y_center-track_h*3, y_center+track_h*3],
                color="#D4AC0D", lw=0.8, ls="--", zorder=2)
        ax.plot([ix1, ix1], [y_center-track_h*3, y_center+track_h*3],
                color="#D4AC0D", lw=0.8, ls="--", zorder=2)

    # TE blocks (draw first, below genes)
    te_df = load_TE(genome)
    for _, tr in te_df.iterrows():
        tx0 = g2x(tr["start"])
        tx1 = g2x(tr["end"])
        if tx1 < 0 or tx0 > 1:
            continue
        tx0 = max(0, tx0); tx1 = min(1, tx1)
        tc = te_color(tr["cls"])
        # Draw as thin colored rectangles on the backbone
        rect = mpatches.FancyBboxPatch(
            (tx0, y_center - track_h * 0.8), tx1 - tx0, track_h * 1.6,
            boxstyle="square,pad=0", color=tc, alpha=0.75, zorder=2, linewidth=0
        )
        ax.add_patch(rect)

    # Gene arrows
    for gs, ge, gstrand, gcolor, glabel in GENES.get(genome, []):
        gx0 = g2x(gs); gx1 = g2x(ge)
        if gx1 < 0 or gx0 > 1:
            continue
        gx0 = max(0, gx0); gx1 = min(1, gx1)
        gene_w = gx1 - gx0
        # Arrow direction
        if gstrand == "-":
            gx0, gx1 = gx1, gx0  # flip for FancyArrow
        head_len = min(gene_w * 0.3, 0.01)
        dx = gx1 - gx0
        ax.add_patch(FancyArrow(
            gx0, y_center, dx, 0,
            width=track_h * 2, head_width=track_h * 3,
            head_length=head_len,
            length_includes_head=True,
            color=gcolor, zorder=5, linewidth=0
        ))
        # Label
        xm = (gx0 + gx1) / 2
        ax.text(xm, y_center + track_h * 3.2, glabel,
                ha="center", va="bottom", fontsize=6.5, fontstyle="italic",
                color=gcolor, zorder=6, clip_on=True)

    # Genome label on left
    mt = MT_LABELS.get(genome, "?")
    mt_col = "#C0392B" if "sexM" in mt else ("#E8671A" if "sexP" in mt else "#777777")
    sp_name = GROUPS.get(genome, genome)
    ax.text(-0.01, y_center, f"$\\it{{{sp_name.replace(' ', '\\ ')}}}$\n({genome}, {mt})",
            ha="right", va="center", fontsize=6, transform=ax.transAxes)

    ax.set_ylim(0, 1)
    ax.set_xlim(0, 1)
    ax.axis("off")

def draw_synteny_band(ax_top, ax_bot, q_genome, t_genome, alpha=0.25):
    """Draw synteny ribbons between two track axes using transformation."""
    blocks = load_PAF(q_genome, t_genome)
    if not blocks:
        # Try reverse
        blocks_r = load_PAF(t_genome, q_genome)
        if blocks_r:
            blocks = [{"q_start": b["t_start"], "q_end": b["t_end"],
                        "t_start": b["q_start"], "t_end": b["q_end"],
                        "strand": b["strand"], "alen": b["alen"]}
                       for b in blocks_r]

    if not blocks:
        return

    q_scaf, q_s, q_e = WINDOWS[q_genome]
    t_scaf, t_s, t_e = WINDOWS[t_genome]
    qlen = q_e - q_s
    tlen = t_e - t_s

    from matplotlib.transforms import blended_transform_factory

    for b in blocks:
        qx0 = (b["q_start"] - q_s) / qlen
        qx1 = (b["q_end"]   - q_s) / qlen
        tx0 = (b["t_start"] - t_s) / tlen
        tx1 = (b["t_end"]   - t_s) / tlen

        # Clamp
        qx0 = max(0, min(1, qx0)); qx1 = max(0, min(1, qx1))
        tx0 = max(0, min(1, tx0)); tx1 = max(0, min(1, tx1))

        col = "#D2B4DE" if b["strand"] == "+" else "#FADBD8"

        # Use figure transforms to draw the band between two axes
        # We draw in the TOP axis with ymin=0 (bottom of top track)
        # and extend to ymax through data coords – simpler: just draw in the gap
        # between axes using top-axis coordinates for top edge and
        # bottom-axis for bottom edge. We'll use a combined approach.
        trans_top = blended_transform_factory(ax_top.transData, ax_top.transAxes)
        trans_bot = blended_transform_factory(ax_bot.transData, ax_bot.transAxes)

        # Get figure coords of top-track bottom edge and bot-track top edge
        fig = ax_top.get_figure()
        # top track: bottom edge = ymin=0 in axes coords
        p_tl = ax_top.transAxes.transform([qx0, 0])
        p_tr = ax_top.transAxes.transform([qx1, 0])
        p_bl = ax_bot.transAxes.transform([tx0, 1])
        p_br = ax_bot.transAxes.transform([tx1, 1])

        # Convert to figure coords then to top-axis data coords
        # Easier: draw polygon in figure coordinates
        figcoords = fig.transFigure.inverted()
        fl = figcoords.transform(p_tl)
        fr = figcoords.transform(p_tr)
        bl = figcoords.transform(p_bl)
        br = figcoords.transform(p_br)

        poly = plt.Polygon([fl, fr, br, bl], closed=True,
                            transform=fig.transFigure,
                            color=col, alpha=alpha, zorder=0, linewidth=0)
        fig.add_artist(poly)


# ─── Main figure ──────────────────────────────────────────────────────────────
N = len(TRACK_ORDER)
fig_h = 2.5 * N
fig = plt.figure(figsize=(16, fig_h))
fig.patch.set_facecolor("white")

# Create subplots with tight spacing between groups
# Group separations: add extra space between groups
# Order: Mucor(2) | gap | Phycobl(2) | gap | Rhizopus(2) | gap | Pnit(2)
heights = [3, 3, 1.5, 3, 3, 1.5, 3, 3, 1.5, 3, 3]
gs = gridspec.GridSpec(11, 1, figure=fig, height_ratios=heights, hspace=0.05)

TRACK_AXES = {}
gap_idx = [2, 5, 8]  # indices in gs that are gaps
track_gs_idx = [0, 1, 3, 4, 6, 7, 9, 10]  # indices for actual tracks

axes = {}
for i, (gs_i, sp) in enumerate(zip(track_gs_idx, TRACK_ORDER)):
    ax = fig.add_subplot(gs[gs_i])
    axes[sp] = ax

# Draw each track
for sp in TRACK_ORDER:
    draw_genome_track(axes[sp], sp)

# Add scale bar on last track
axes["PnitSJTU"].annotate("", xy=(0.9, 0.1), xytext=(0.9 - 10000/100000, 0.1),
                            xycoords="axes fraction",
                            arrowprops=dict(arrowstyle="-", color="black", lw=1.5))
axes["PnitSJTU"].text(0.9 - 5000/100000, 0.05, "10 kb", ha="center", va="top",
                       fontsize=7, transform=axes["PnitSJTU"].transAxes)

# Draw synteny bands between adjacent tracks
draw_synteny_band(axes["Mucci3"],    axes["mu402"],    "Mucci3",    "mu402")
draw_synteny_band(axes["PhyblU21"],  axes["Phybl4"],   "PhyblU21",  "Phybl4")
draw_synteny_band(axes["Rarr_CCUG"], axes["RhiMicr1"], "Rarr_CCUG", "RhiMicr1")
draw_synteny_band(axes["PnitS607"],  axes["PnitSJTU"], "PnitS607",  "PnitSJTU")

# Group brackets on right side
GROUP_TICKS = [
    (["Mucci3","mu402"],          "Mucorales\nMucor"),
    (["PhyblU21","Phybl4"],       "Mucorales\nPhycomyces bl."),
    (["Rarr_CCUG","RhiMicr1"],    "Mucorales\nRhizopus"),
    (["PnitS607","PnitSJTU"],     "Mucorales\nPhycomyces nitens"),
]
for splist, glabel in GROUP_TICKS:
    ax0 = axes[splist[0]]
    ax1 = axes[splist[-1]]
    # Draw bracket using figure coordinates
    p0 = ax0.get_position(); p1 = ax1.get_position()
    x  = p0.x1 + 0.01
    y0 = p1.y0; y1 = p0.y1
    ymid = (y0 + y1) / 2
    ax0.annotate("", xy=(x, y0), xytext=(x, y1),
                 xycoords="figure fraction", textcoords="figure fraction",
                 arrowprops=dict(arrowstyle="-", color="#555555", lw=1.2,
                                 connectionstyle="arc3,rad=0"))
    ax0.text(x + 0.005, ymid, glabel, ha="left", va="center", fontsize=7,
             transform=ax0.figure.transFigure, color="#555555",
             rotation=90 if "\n" not in glabel else 0)

# Legend
legend_elements = [
    mpatches.Patch(color="#E8671A", label="sexP gene"),
    mpatches.Patch(color="#C0392B", label="sexM gene"),
    mpatches.Patch(color="#27AE60", label="tptA"),
    mpatches.Patch(color="#2980B9", label="rnhA"),
    mpatches.Patch(color="#F9E79F", label="Idiomorphic region"),
    mpatches.Patch(color="#8E44AD", label="LTR element"),
    mpatches.Patch(color="#2471A3", label="LINE element"),
    mpatches.Patch(color="#D4AC0D", label="DNA transposon"),
    mpatches.Patch(color="#95A5A6", label="Unknown TE"),
    mpatches.Patch(color="#D2B4DE", label="Synteny (same strand)"),
    mpatches.Patch(color="#FADBD8", label="Synteny (inverted)"),
]
fig.legend(handles=legend_elements, loc="lower center", ncol=6,
           fontsize=7, frameon=True, framealpha=0.9, edgecolor="lightgray",
           bbox_to_anchor=(0.5, -0.02))

fig.suptitle("Sex determination locus synteny across Mucorales\n"
             "(representative high-quality assemblies)",
             fontsize=11, fontweight="bold", y=1.01)

out_pdf = WORKDIR / "sex_locus_synteny_figure.pdf"
out_png = WORKDIR / "sex_locus_synteny_figure.png"
fig.savefig(out_pdf, dpi=200, bbox_inches="tight")
fig.savefig(out_png, dpi=150, bbox_inches="tight")
print(f"Saved: {out_pdf}")
print(f"Saved: {out_png}")
plt.close()
